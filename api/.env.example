# admin-platform API 环境变量
# 使用方式：cp .env.example .env

# 运行环境：development / production / test
NODE_ENV=development

# 服务端口（Swagger 挂载在 /api/docs，健康检查在 /health）
PORT=3000

# PostgreSQL（对应仓库根 docker-compose.yml 的 postgres 服务）
DATABASE_URL=postgresql://admin:admin123456@localhost:5432/admin_platform?schema=public

# Redis（M11 缓存、限流、会话治理使用）
REDIS_URL=redis://localhost:6379

# JWT 签名密钥（必填；本地随便填，生产必须换成强随机值）
JWT_SECRET=please-change-me-in-local-env
